  <Element Type="FunctionDef" Id="00000136">
    <Identifier>SetVariable</Identifier>
    <Label Type="Label" Library="Ntve" Id="CE915C5A" />
    <FlagAction />
    <FlagOperator />
    <Parameter Type="ParamDef" Library="Ntve" Id="00000219" />
    <Parameter Type="ParamDef" Library="Ntve" Id="00000220" />
    <ScriptCode>
