  </Element>
  <Element Type="FunctionDef" Id="00000137">
    <Identifier>IfThenElse</Identifier>
    <Label Type="Label" Library="Ntve" Id="00000002" />
    <FlagAction />
    <FlagSubFunctions />
    <SubFunctionType Type="SubFuncType" Library="Ntve" Id="00000003" />
    <SubFunctionType Type="SubFuncType" Library="Ntve" Id="00000004" />
    <SubFunctionType Type="SubFuncType" Library="Ntve" Id="00000005" />
    <ScriptCode>
            if (#SUBFUNCS(if," &amp;&amp; ")) {
                #SUBFUNCS(then)
            }
            #IFHAVESUBFUNCS(else,else {
            )
                #SUBFUNCS(else)
            #IFHAVESUBFUNCS(else,})
        </ScriptCode>
  </Element>
  <Element Type="FunctionDef" Id="71596144">
    <Identifier>While</Identifier>
    <Label Type="Label" Library="Ntve" Id="00000002" />
    <FlagAction />
    <FlagSubFunctions />
    <FlagAllowBreak />
    <SubFunctionType Type="SubFuncType" Library="Ntve" Id="20298AEC" />
    <SubFunctionType Type="SubFuncType" Library="Ntve" Id="A1B37466" />
    <ScriptCode>
            while (#SUBFUNCS(Conditions," &amp;&amp; ")) {
                #SUBFUNCS(Actions)
            }
        </ScriptCode>
  </Element>
  <Element Type="FunctionDef" Id="CEDAB9C3">
    <Identifier>RepeatForever</Identifier>
    <Label Type="Label" Library="Ntve" Id="00000002" />
    <FlagAction />
    <FlagSubFunctions />
    <FlagAllowBreak />
    <SubFunctionType Type="SubFuncType" Library="Ntve" Id="4945FAA8" />
    <ScriptCode>
            while (true) {
                #SUBFUNCS(actions)
            }
        </ScriptCode>
  </Element>
