            <xs:enumeration value="Multiply"/>
            <xs:enumeration value="Normal"/>
            <xs:enumeration value="Subtract"/>
        </xs:restriction>
    </xs:simpleType>
    
    <xs:simpleType name="BooleanBase">
        <xs:restriction base="xs:string">
            <xs:enumeration value="true"/>
            <xs:enumeration value="false"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="Boolean">
        <xs:union memberTypes="sc2l:ConstantVal sc2l:BooleanBase"/>
    </xs:simpleType>

    <xs:simpleType name="UnsignedInteger">
        <xs:union memberTypes="sc2l:ConstantVal xs:unsignedInt"/>
    </xs:simpleType>
    
    <xs:simpleType name="Integer">
        <xs:union memberTypes="sc2l:ConstantVal xs:int"/>
    </xs:simpleType>
    
    <xs:simpleType name="FloatBase">
        <xs:restriction base="xs:string">
            <xs:pattern value="[+|-]{0,1}[0-9]{1,6}([.][0-9]{1,6}){0,1}"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="Float">
        <xs:union memberTypes="sc2l:ConstantVal sc2l:FloatBase"/>
    </xs:simpleType>

    <xs:simpleType name="Float3Base">
        <xs:restriction base="xs:string">
            <xs:pattern value="[+|-]{0,1}[0-9]{1,6}([.][0-9]{1,6}){0,1},[ ]*[+|-]{0,1}[0-9]{1,6}([.][0-9]{1,6}){0,1},[ ]*[+|-]{0,1}[0-9]{1,6}([.][0-9]{1,6}){0,1}"/>
