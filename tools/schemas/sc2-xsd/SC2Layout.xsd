    </xs:simpleType>
    <xs:simpleType name="Float3">
        <xs:union memberTypes="sc2l:ConstantVal sc2l:Float3Base"/>
    </xs:simpleType>
    
    <xs:simpleType name="Color3Base">
        <xs:restriction base="xs:string">
            <xs:pattern value="(([0-9])|([1-9][0-9])|(1[0-9][0-9])|(2[0-4][0-9])|(25[0-5])),[ ]*(([0-9])|([1-9][0-9])|(1[0-9][0-9])|(2[0-4][0-9])|(25[0-5])),[ ]*(([0-9])|([1-9][0-9])|(1[0-9][0-9])|(2[0-4][0-9])|(25[0-5]))"/>
            <xs:pattern value="[a-fA-F0-9]{6}"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="Color3">
        <xs:union memberTypes="sc2l:ConstantVal sc2l:Color3Base"/>
    </xs:simpleType>
    
    <xs:simpleType name="ColorSingleBase">
