							<xs:documentation>
								<![CDATA[Cues
Cue parameters for each sound in the soundtrack. These parameters also let you add tracks to the soundtrack.]]>
							</xs:documentation>
						</xs:annotation>
						<xs:complexType>
							<xs:complexContent>
								<xs:extension base="SSoundtrackCue">
									<xs:attribute name="index" type="simple_indexIntOrName"/>
