	<xs:complexType name="CSoundExclusivity">
		<xs:complexContent>
			<xs:extension base="CBase">
				<xs:choice minOccurs="0" maxOccurs="unbounded">
					<xs:element minOccurs="0" maxOccurs="1" name="Group" type="uint32">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Exclusivity Group
The exclusivity group of the sound.  All sounds played using this group will consider each other for exclusivity.  Sounds from other groups, or who don't have any group, will not be considered for exclusivity tests.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="Priority" type="real32">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Priority
The priority within the exclusivity group.  Used to make decisions about which sounds are more important than others.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="CollideWithLower" type="EExclusivityAction">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[On Collide With Lower
What action to take if a lower priority sound is already playing when the sound wants to play.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="CollideWithEqual" type="EExclusivityAction">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[On Collide With Equal
What action to take if an equal priority sound is already playing when the sound wants to play.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="CollideWithHigher" type="EExclusivityAction">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[On Collide With Higher
What action to take if a higher priority sound is already playing when the sound wants to play.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="QCollideWithLower" type="EExclusivityQueueAction">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[On Queue Collide With Lower
What action to take if a lower priority sound is already queued when the sound wants to enter the queue.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="QCollideWithEqual" type="EExclusivityQueueAction">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[On Queue Collide With Equal
What action to take if an equal priority sound is already queued when the sound wants to enter the queue.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="QCollideWithHigher" type="EExclusivityQueueAction">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[On Queue Collide With Higher
What action to take if a higher priority sound is already queued when the sound wants to enter the queue.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="QTimeout" type="uint32">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Queue Timeout
If the sound is queued for longer than this amount of time (in ms), it will give up and leave the queue without playing. A value of zero means it will never time out.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="QDelay" type="uint32">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Queue Play Delay
When a sound is dequeued, it will wait this long (in ms) before playing.  This delay does not count towards the queue timeout time.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="InterruptFadeBlend" type="ESoundBlend">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Interrupt Fade Blend
If this sound is interrupted, it will blend out using this setting.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="unbounded" name="InterruptFade">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Interrupt Fade
If this sound is interrupted, it will blend out using this setting.]]>
							</xs:documentation>
						</xs:annotation>
						<xs:complexType>
							<xs:complexContent>
								<xs:extension base="SVolumeFade">
									<xs:attribute name="index" type="simple_indexIntOrName"/>
									<xs:attribute name="removed" type="simple_bool"/>
								</xs:extension>
							</xs:complexContent>
						</xs:complexType>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="InterruptDelay" type="uint32">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Interrupt Delay
If this sound is interrupted, the sound interrupting it will delay it's playback by this amount to allow this sound to fade out etc.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="unbounded" name="Flags">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Flags]]>
							</xs:documentation>
						</xs:annotation>
						<xs:complexType>
							<xs:complexContent>
								<xs:extension base="bool">
									<xs:attribute name="index" type="simple_ESoundExclusivityFlag"/>
									<xs:attribute name="removed" type="simple_bool"/>
								</xs:extension>
							</xs:complexContent>
						</xs:complexType>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="unbounded" name="SuppressGroups">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Suppress Groups
When a sound plays using this exclusivity data record, it will suppress these group numbers for ALL owning players.  Sounds in those groups will not be able to be played again until this sound is finished, and if the SupressionInterrupts flag is set, currently playing sounds will be interrupted.]]>
							</xs:documentation>
