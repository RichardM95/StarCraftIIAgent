	<xs:simpleType name="simple_EActorFilter">
		<xs:restriction base="xs:string">
			<xs:enumeration value="All">
				<xs:annotation>
					<xs:documentation>
						<![CDATA[All
When on, prevents the actor from being seen by anyone.  Typically used to mask an actor from everyone, followed by several player-specific unmask operations.  (It is less data to filter out all players and then un-filter two than it is to filter 14 players individually.)]]>
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Ally">
				<xs:annotation>
					<xs:documentation>
						<![CDATA[Ally
When on, prevents the actor from being seen by allied players.]]>
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Enemy">
				<xs:annotation>
					<xs:documentation>
						<![CDATA[Enemy
When on, prevents the actor from being seen by enemy players.]]>
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Neutral">
				<xs:annotation>
					<xs:documentation>
						<![CDATA[Neutral
When on, prevents the actor from being seen by neutral players.]]>
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Self">
				<xs:annotation>
					<xs:documentation>
						<![CDATA[Self
When on, prevents the actor from being seen by its owning player.]]>
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
