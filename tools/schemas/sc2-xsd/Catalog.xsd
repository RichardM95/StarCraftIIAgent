	<xs:complexType name="EActorOverkillTestType">
		<xs:attribute name="value" type="simple_EActorOverkillTestType"/>
	</xs:complexType>
	<xs:simpleType name="simple_EActorOverkillTestType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="Fixed">
				<xs:annotation>
					<xs:documentation>
						<![CDATA[Test Fixed
A killing blow counts as an overkill if it inflicts X points of damage or more past what was necessary to kill the unit.]]>
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PercentageOfMaxLife">
				<xs:annotation>
					<xs:documentation>
						<![CDATA[Test Percentage Of Max Life
Measures overkill as a percentage of maximum health.  Example: A unit being killed by an attack that inflicts damage beyond what was necessary to kill the target by at least 20% of the target unit's maximum health.]]>
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PercentageOfMaxLifePlusShields">
				<xs:annotation>
					<xs:documentation>
						<![CDATA[Test Percentage Of Max Life Plus Shields
Like the PercentageOfMaxLife option, but measures overkill as a percentage of maximum health plus maximum shields.]]>
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="EActorOverkillType">
		<xs:attribute name="value" type="simple_EActorOverkillType"/>
	</xs:complexType>
	<xs:simpleType name="simple_EActorOverkillType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="DamageOverInterval">
				<xs:annotation>
					<xs:documentation>
						<![CDATA[Damage Over Interval
Specifies that a unit was overkilled if it was taking greater than or equal to X amount of damage over Y time interval at its time of death.]]>
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DamagePastRemainingHealth">
				<xs:annotation>
					<xs:documentation>
						<![CDATA[Damage Past Remaining Health
Specifies that a unit was overkilled if the killing blow inflicted greater than or equal to X amount of damage more than was necessary to kill the unit.]]>
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TestFixed">
				<xs:annotation>
					<xs:documentation>
						<![CDATA[Test Fixed
A killing blow counts as an overkill if it inflicts X points of damage or more past what was necessary to kill the unit.]]>
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TestPercentageOfMaxLife">
				<xs:annotation>
					<xs:documentation>
						<![CDATA[Test Percentage Of Max Life
Measures overkill as a percentage of maximum health.  Example: A unit being killed by an attack that inflicts damage beyond what was necessary to kill the target by at least 20% of the target unit's maximum health.]]>
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TestPercentageOfMaxLifePlusShields">
				<xs:annotation>
					<xs:documentation>
						<![CDATA[Test Percentage Of Max Life Plus Shields
Like the PercentageOfMaxLife option, but measures overkill as a percentage of maximum health plus maximum shields.]]>
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
