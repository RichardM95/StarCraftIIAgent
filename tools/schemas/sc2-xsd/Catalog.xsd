						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="Deceleration" type="CGameAcceleration">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Deceleration
Rate at which the unit's speed decreases until it comes to a complete stop]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="LateralAcceleration" type="CGameAcceleration">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Lateral Acceleration
Amount of side-to-side speed the unit gains until it reaches its maximum speed]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="StationaryTurningRate" type="CFangleRate">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Stationary Turning Rate
Speed at which the unit turns while stationary]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="TurningRate" type="CFangleRate">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Turning Rate
Speed at which the unit turns while moving]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="Sight" type="CFixed">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Sight Radius
The units sight radius.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="unbounded" name="SightBonus">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Sight Bonus
Modifiers to the unit's sight radius depending on the time of day.]]>
							</xs:documentation>
						</xs:annotation>
						<xs:complexType>
							<xs:complexContent>
								<xs:extension base="CFixed">
									<xs:attribute name="index" type="simple_EGameTimeEvent"/>
									<xs:attribute name="removed" type="simple_bool"/>
								</xs:extension>
							</xs:complexContent>
						</xs:complexType>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="Height" type="CFixed">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Height
Distance from the ground at which the unit appears]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="VisionHeight" type="CFixed">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Vision Height
Height of the unit's field of vision]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="OccludeHeight" type="CFixed">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Occlusion Height
Specifies how much this unit adjusts the vision line of sight for cells in its footprint that request to do so.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="BoostedCliffLevel" type="TCliffLevel">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Boosted Cliff Level
Specifies how much to change the cliff levels by for cells that request it in the unit's footprint.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="unbounded" name="BoostedHeight">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Boosted Height
Specifies how much the height map is raised by for cells that request it in the unit's footprint.]]>
							</xs:documentation>
						</xs:annotation>
						<xs:complexType>
							<xs:complexContent>
								<xs:extension base="CFixed">
									<xs:attribute name="index" type="simple_EHeightMap"/>
									<xs:attribute name="removed" type="simple_bool"/>
								</xs:extension>
							</xs:complexContent>
						</xs:complexType>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="Food" type="CFixed">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Supplies
Amount of food or supplies the unit uses when active. If this value is positive, the unit raises the supply limit.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="CostCategory" type="ECostCategory">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Cost Category
The Leader Panel uses Cost Category to determine whether this unit is listed as Technology, Economy, or Army.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="unbounded" name="CostResource">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Cost
The amount of each resource that it will cost to build, train, or repair this unit.]]>
							</xs:documentation>
						</xs:annotation>
						<xs:complexType>
							<xs:complexContent>
								<xs:extension base="int32">
									<xs:attribute name="index" type="simple_EResourceType"/>
									<xs:attribute name="removed" type="simple_bool"/>
								</xs:extension>
							</xs:complexContent>
						</xs:complexType>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="PawnItemReduction" type="CFixed">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Pawn Item Reduction
The percentage of the original unit's cost returned when sold as an item which uses the Pawn ability.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="RepairTime" type="CGameTime">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Repair Time
Time it takes to repair the unit]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="ReviveTime" type="CGameTime">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Revive Time
A flat amount of time it takes to revive the unit which is also added to the level-based revive time.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="AttackTargetPriority" type="TAttackTargetPriority">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Attack Target Priority
Priority for the unit. When one unit has a higher priority than other units, the higher priority unit is attacked first by the default tactical AI.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="AIOverideTargetPriority" type="TAttackTargetPriority">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[AI Override Target Priority
Priority for the unit that is used when the attacking unit is controlled by an AI player. When one unit has a higher priority than other units, the higher priority unit is attacked first.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="DamageDealtXP" type="uint32">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Damage Dealt (Veterancy)
Multiplier for experience points the unit is awarded per point of damage it deals.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="DamageTakenXP" type="uint32">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Damage Taken (Veterancy)
Multiplier for experience points the unit is awarded per point of damage it takes.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="KillXP" type="uint32">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Kill Experience
Number of experience points the unit awards to its killer.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="unbounded" name="KillResource">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Kill Resource
Resources gained from killing this unit.]]>
							</xs:documentation>
						</xs:annotation>
						<xs:complexType>
							<xs:complexContent>
								<xs:extension base="int32">
									<xs:attribute name="index" type="simple_EResourceType"/>
									<xs:attribute name="removed" type="simple_bool"/>
								</xs:extension>
							</xs:complexContent>
						</xs:complexType>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="unbounded" name="AbilArray">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Abilities
Any abilities added to the unit in this field will be available for use by this unit assuming they are also added to the Command Card. Abilities allow units to use spells like Psi Storm or buffs like Stim Pack by linking the Unit to a set of Effects that will be executed.]]>
							</xs:documentation>
						</xs:annotation>
						<xs:complexType>
							<xs:complexContent>
								<xs:extension base="SUnitAbilData">
									<xs:attribute name="index" type="simple_indexIntOrName"/>
									<xs:attribute name="removed" type="simple_bool"/>
								</xs:extension>
							</xs:complexContent>
						</xs:complexType>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="unbounded" name="BehaviorArray">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Behaviors
Any behaviors added to the unit in this field are automatically applied to the unit when it is created. Behaviors can modify most of the inherent attributes of a unit including movement speed, armor values, and cloaking/detection.]]>
							</xs:documentation>
						</xs:annotation>
						<xs:complexType>
							<xs:complexContent>
								<xs:extension base="SUnitBehaviorData">
									<xs:attribute name="index" type="simple_indexIntOrName"/>
									<xs:attribute name="removed" type="simple_bool"/>
								</xs:extension>
							</xs:complexContent>
						</xs:complexType>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="unbounded" name="TurretArray">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Turrets
Turret objects may be used to allow units to attack targets that they aren't facing directly. They may also be configured to rotate when idle like the Missile Tower.]]>
							</xs:documentation>
						</xs:annotation>
						<xs:complexType>
							<xs:complexContent>
								<xs:extension base="CTurretLink">
									<xs:attribute name="index" type="simple_indexIntOrName"/>
									<xs:attribute name="removed" type="simple_bool"/>
								</xs:extension>
							</xs:complexContent>
						</xs:complexType>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="unbounded" name="WeaponArray">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Weapons
Units that have an Attack ability will attack with the weapons defined here. Weapons control parameters like attack speed, attack range, and which targets are valid for an attack. When the weapon fires, it can only damage a unit or apply other modifiers by executing the Effect that it is configured to use.]]>
							</xs:documentation>
						</xs:annotation>
						<xs:complexType>
							<xs:complexContent>
								<xs:extension base="SUnitWeaponData">
									<xs:attribute name="index" type="simple_indexIntOrName"/>
									<xs:attribute name="removed" type="simple_bool"/>
								</xs:extension>
							</xs:complexContent>
						</xs:complexType>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="unbounded" name="EffectArray">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Effect]]>
							</xs:documentation>
						</xs:annotation>
						<xs:complexType>
							<xs:complexContent>
								<xs:extension base="CEffectLink">
									<xs:attribute name="index" type="simple_EUnitEffect"/>
									<xs:attribute name="removed" type="simple_bool"/>
								</xs:extension>
							</xs:complexContent>
						</xs:complexType>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="unbounded" name="CardLayouts">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Command Card
The command card for each unit defines a set of buttons for that unit to be displayed when that unit is selected, typically as a grid in the bottom right of the screen. The buttons displayed here can be used to activate or target an ability like Attack or Stim Pack, but can also be used for other purposes like temporarily switching the command card to a different 'card' of buttons or for displaying a button for a passive behavior on that unit.]]>
							</xs:documentation>
						</xs:annotation>
						<xs:complexType>
							<xs:complexContent>
								<xs:extension base="SCardLayout">
									<xs:attribute name="index" type="simple_indexIntOrName"/>
									<xs:attribute name="removed" type="simple_bool"/>
								</xs:extension>
							</xs:complexContent>
						</xs:complexType>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="Radius" type="TUnitRadius">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Radius
Radius at which the unit can interact with other units]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="DeadRadius" type="TUnitRadius">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Radius - Dead
Collision radius of the unit when it is dead]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="SeparationRadius" type="CFixed">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Separation Radius
Distance between Air units in a squadron]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="InnerRadius" type="TUnitRadius">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Inner Radius
Radius at which the unit can interact with buildings]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="DeadInnerRadius" type="TUnitRadius">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Inner Radius While Dead
Radius at which the unit can interact with buildings when it is dead]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="CargoOverlapFilters" type="CTargetFilters">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Cargo Overlap Filters
Specifies a set of filters to use when unloading this unit from a transport to decide what units near the unload location should be ignored.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="CargoSize" type="TCargoSize">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Cargo Size
Number of cargo slots for the unit]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="Footprint" type="CFootprintLink">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Pathing Footprint
Footprint used by the unit.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="DeadFootprint" type="CFootprintLink">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Pathing Footprint - Dead
Pathing footprint of the unit when it is dead]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="PlacementFootprint" type="CFootprintLink">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Pathing Footprint - Placement
Footprint of the unit for the placement grid]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="unbounded" name="AddedOnArray">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Added On Units
Add-on parameters for the unit. These values determine how the add-on affects the host unit.]]>
							</xs:documentation>
						</xs:annotation>
						<xs:complexType>
							<xs:complexContent>
								<xs:extension base="SAddedOnData">
									<xs:attribute name="index" type="simple_indexIntOrName"/>
									<xs:attribute name="removed" type="simple_bool"/>
								</xs:extension>
							</xs:complexContent>
						</xs:complexType>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="AddOnOffsetX" type="CFixed">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Add On Offset X
Offset position from the host building along the X-axis at which the add-on appears]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="AddOnOffsetY" type="CFixed">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Add On Offset Y
Offset position from the host building along the Y-axis at which the add-on appears]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="unbounded" name="BuiltOn">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Built On
Existing unit on which the unit must be built]]>
							</xs:documentation>
						</xs:annotation>
						<xs:complexType>
							<xs:complexContent>
								<xs:extension base="CUnitLink">
									<xs:attribute name="index" type="simple_indexIntOrName"/>
									<xs:attribute name="removed" type="simple_bool"/>
								</xs:extension>
							</xs:complexContent>
						</xs:complexType>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="unbounded" name="BuildOnAs">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Build On As
Allows you to modify the type of building constructed on another building based on the built-upon building's built on list.]]>
							</xs:documentation>
						</xs:annotation>
						<xs:complexType>
							<xs:complexContent>
								<xs:extension base="CUnitLink">
									<xs:attribute name="index" type="simple_indexIntOrName"/>
									<xs:attribute name="removed" type="simple_bool"/>
								</xs:extension>
							</xs:complexContent>
						</xs:complexType>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="ScoreMake" type="int32">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Score - Produce
Score that the Player gains when the unit is built]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="unbounded" name="ScoreMakeCostFactor">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Score Make Cost Factor]]>
							</xs:documentation>
						</xs:annotation>
						<xs:complexType>
							<xs:complexContent>
								<xs:extension base="CFixed">
									<xs:attribute name="index" type="simple_EResourceType"/>
									<xs:attribute name="removed" type="simple_bool"/>
								</xs:extension>
							</xs:complexContent>
						</xs:complexType>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="ScoreKill" type="int32">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Score - Kill
Score that the Player gains when killing the unit]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="unbounded" name="ScoreKillCostFactor">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Score Kill Cost Factor]]>
							</xs:documentation>
						</xs:annotation>
						<xs:complexType>
							<xs:complexContent>
								<xs:extension base="CFixed">
									<xs:attribute name="index" type="simple_EResourceType"/>
									<xs:attribute name="removed" type="simple_bool"/>
								</xs:extension>
							</xs:complexContent>
						</xs:complexType>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="ScoreLost" type="int32">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Score - Lost
Score that the Player gains when the unit dies]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="unbounded" name="ScoreLostCostFactor">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Score Lost Cost Factor]]>
							</xs:documentation>
						</xs:annotation>
						<xs:complexType>
							<xs:complexContent>
								<xs:extension base="CFixed">
									<xs:attribute name="index" type="simple_EResourceType"/>
									<xs:attribute name="removed" type="simple_bool"/>
								</xs:extension>
							</xs:complexContent>
						</xs:complexType>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="ScoreResult" type="CScoreResultLink">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Score Result
Specifies whether this unit type appears on the Build Order tab of the end-of-game score screen.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="SubgroupPriority" type="uint8">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Subgroup Priority
This will determine the display priority within the info panel when multiple unit subgroups are selected.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="MinimapRadius" type="CFixed">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Minimap Radius
Size of the unit on the minimap]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="EditorCategories" type="TEditorCategories">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Editor Categories
Editor Categories are used for filtering and organization within the StarCraft II Editor.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="TacticalAI" type="CTacticalLink">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Tactical AI
Specifies which tactical AI data is in charge of issuing this unit's orders when under AI control.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="TacticalAIRange" type="TGalaxyFunction">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Tactical AI Range
Range reference for the unit's tactical artificial intelligence]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="TacticalAIThink" type="TGalaxyFunction">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Tactical AI Function
Function or code that runs the unit's tactical artificial intelligence]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="TacticalAIChannel" type="TGalaxyFunction">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Tactical AI Channel
Specifies a trigger function that should be called periodically while an order is being channeled so that the AI can cancel the order, if desired.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="TacticalAIFilters" type="CTargetFilters">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Tactical AI Filters
Filter set for the tactical artificial intelligence's responses to targets]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="AIEvalFactor" type="CFixed">
