				<xs:attribute name="Name" type="simple_CStringLink">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Name
Name of the unit]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="Subtitle" type="simple_CStringLink">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Subtitle
A secondary name or title that is displayed under a unit's primary name.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="Description" type="simple_CStringLink">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Description
Tooltip text description of the unit.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="InfoTooltipPriority" type="simple_uint32">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Tooltip Priority
This will affect the order of produced units listed by the "Produced Unit Information" text tag. A value of 0 will exclude this unit from the list.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="DeathTime" type="simple_CGameTime">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Death Time
Amount of time it takes the unit to die. After this time, the unit will be removed from the game, and not able to be referenced. Setting to -1 will cause the unit to always be 'in the game' even if it is dead.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="DeathRevealFilters" type="simple_CTargetFilters">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Death Reveal Filters
When this unit dies, it will trigger a combat reveal for any units passing these filters in the death reveal radius around it.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="DeathRevealRadius" type="simple_CFixed">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Death Reveal Radius
Size of the area that is revealed around the unit when it dies.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="DeathRevealDuration" type="simple_CGameTime">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Death Reveal Duration
Amount of time the death reveal radius remains visible after the unit dies.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="DeathRevealType" type="simple_EDeathReveal">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Death Reveal Type
This will specify how a unit grants vision of hostile units in the surrounding area when it is killed.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="ReviveDelay" type="simple_CGameTime">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Revive Delay
How long it takes for a unit to be revivable after it dies.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="ReviveType" type="simple_CUnitLink">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Revive Type
Specifies the type of unit this unit should be revived as when it is dead (typically in case this unit type is an alternate form and you want it to revive as the normal form).]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="Facing" type="simple_CFacing">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Facing
Facing angle of the unit in the game and in the StarCraft II Editor. This value only effects units that are not flagged as turnable.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="EditorFacingAlignment" type="simple_CFangle">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Editor Facing Alignment
This determines the facing angle of the unit when placed in the StarCraft II Editor.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="Race" type="simple_CRaceLink">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Race
Race to which the unit belongs]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="Mob" type="simple_EUnitMob">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Mob
Group to which the unit belongs when the MOB cheat is used]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="ResourceState" type="simple_EResourceState">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Resource State
State of the resources contained by the unit. Harvestable means that resources can be harvested from the unit, raw cannot.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="ResourceType" type="simple_EResourceType">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Resource Type
Type of resource the unit contains]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="FogVisibility" type="simple_EFogVisibility">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Fog Visibility
How the unit appears under the fog of war]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="PushPriority" type="simple_CFixed">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Push Priority
Allows for units to push lower priority units out of the way.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="DefaultAcquireLevel" type="simple_EAcquireLevel">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Default Acquire Level
If the unit is idle, this determines how abilities are allowed to acquire targets.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="Response" type="simple_EUnitResponse">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Response
Response from the unit when it takes damage]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="LifeStart" type="simple_CFixed">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Life Starting Amount
Amount of life with which the unit starts. This value cannot exceed the Life Max for the unit.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="LifeMax" type="simple_CFixed">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Life Maximum
Maximum amount of life for the unit]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="LifeArmor" type="simple_CFixed">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Life Armor
Amount of armor for the unit]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="LifeRegenDelay" type="simple_CGameTime">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Life Regeneration Delay
Time between the unit losing life and the unit continuing to regenerate life.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="LifeRegenRate" type="simple_CGameRate">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Life Regeneration Rate
Amount of life the unit gains per second.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="LifeRegenRateCreep" type="simple_CGameRate">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Life Regen Rate Bonus on Creep
Amount of life the unit gains per second while the unit is on creep.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="LifeArmorName" type="simple_CStringLink">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Life Armor Name
Name of the unit's armor]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="LifeArmorLevel" type="simple_uint32">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Life Armor Level
Displayed armor level for the unit. This value does not affect the unit's actual armor value.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="EnergyStart" type="simple_CFixed">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Energy Starting Amount
Amount of energy with which the unit begins. The Energy Start cannot exceed the Energy Max.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="EnergyMax" type="simple_CFixed">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Energy Maximum
Maximum amount of energy the unit can have.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="EnergyRegenDelay" type="simple_CGameTime">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Energy Regeneration Delay
Time between the unit using energy and the unit continuing to regenerate energy.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="EnergyRegenRate" type="simple_CGameRate">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Energy Regeneration Rate
Amount of energy the unit regenerates every second.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="EnergyRegenRateCreep" type="simple_CGameRate">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Energy Regen Rate Bonus on Creep
Amount of energy the unit regenerates every second while the unit is on creep.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="ShieldsStart" type="simple_CFixed">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Shield Starting Amount
Amount of life with which the unit's shield begins. This value cannot exceed the Energy Max for the unit.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="ShieldsMax" type="simple_CFixed">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Shield Maximum
Maximum amount of shields for the unit]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="ShieldArmor" type="simple_CFixed">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Shield Armor
Armor applied against damage when unit has shield remaining, if ShieldDamageRatio greater than zero.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="ShieldRegenDelay" type="simple_CGameTime">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Shield Regeneration Delay
Time it takes for a unit's shield to regenerate after exiting combat.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="ShieldRegenRate" type="simple_CGameRate">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Shield Regeneration Rate
Amount of shield the unit regenerates per second.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="ShieldRegenRateCreep" type="simple_CGameRate">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Shield Regen Rate Bonus on Creep
Amount of shield the unit regenerates per second while the unit is on creep.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="ShieldArmorName" type="simple_CStringLink">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Shield Armor Name
Name of the unit's shield]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="ShieldArmorLevel" type="simple_uint32">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Shield Armor Level
Displayed shield level for the unit. This value does not affect the unit's actual shield armor value.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="Mover" type="simple_CMoverLink">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Mover
Mover type for the unit. The unit's mover affects the way the unit paths.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="Speed" type="simple_CGameSpeed">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Speed
Maximum speed for the unit]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="SpeedBonusCreep" type="simple_CGameSpeed">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Creep Speed Bonus
Bonus speed when the unit is on creep.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="SpeedMultiplierCreep" type="simple_CFixed">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Creep Speed Multiplier
Speed multiplier when the unit is on creep.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="AttackSpeedMultiplierCreep" type="simple_CFixed">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Attack Speed Multiplier On Creep
Increases the attack speed while on creep by multiplying this value by any other attack speed multipliers.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="Acceleration" type="simple_CGameAcceleration">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Acceleration
Rate of speed increase at which the unit reaches maximum speed]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="Deceleration" type="simple_CGameAcceleration">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Deceleration
Rate at which the unit's speed decreases until it comes to a complete stop]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="LateralAcceleration" type="simple_CGameAcceleration">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Lateral Acceleration
Amount of side-to-side speed the unit gains until it reaches its maximum speed]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="StationaryTurningRate" type="simple_CFangleRate">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Stationary Turning Rate
Speed at which the unit turns while stationary]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="TurningRate" type="simple_CFangleRate">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Turning Rate
Speed at which the unit turns while moving]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="Sight" type="simple_CFixed">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Sight Radius
The units sight radius.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="Height" type="simple_CFixed">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Height
Distance from the ground at which the unit appears]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="VisionHeight" type="simple_CFixed">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Vision Height
Height of the unit's field of vision]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="OccludeHeight" type="simple_CFixed">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Occlusion Height
Specifies how much this unit adjusts the vision line of sight for cells in its footprint that request to do so.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="BoostedCliffLevel" type="simple_TCliffLevel">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Boosted Cliff Level
Specifies how much to change the cliff levels by for cells that request it in the unit's footprint.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="Food" type="simple_CFixed">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Supplies
Amount of food or supplies the unit uses when active. If this value is positive, the unit raises the supply limit.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="CostCategory" type="simple_ECostCategory">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Cost Category
The Leader Panel uses Cost Category to determine whether this unit is listed as Technology, Economy, or Army.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="PawnItemReduction" type="simple_CFixed">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Pawn Item Reduction
The percentage of the original unit's cost returned when sold as an item which uses the Pawn ability.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="RepairTime" type="simple_CGameTime">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Repair Time
Time it takes to repair the unit]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="ReviveTime" type="simple_CGameTime">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Revive Time
A flat amount of time it takes to revive the unit which is also added to the level-based revive time.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="AttackTargetPriority" type="simple_TAttackTargetPriority">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Attack Target Priority
Priority for the unit. When one unit has a higher priority than other units, the higher priority unit is attacked first by the default tactical AI.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="AIOverideTargetPriority" type="simple_TAttackTargetPriority">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[AI Override Target Priority
Priority for the unit that is used when the attacking unit is controlled by an AI player. When one unit has a higher priority than other units, the higher priority unit is attacked first.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="DamageDealtXP" type="simple_uint32">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Damage Dealt (Veterancy)
Multiplier for experience points the unit is awarded per point of damage it deals.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="DamageTakenXP" type="simple_uint32">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Damage Taken (Veterancy)
Multiplier for experience points the unit is awarded per point of damage it takes.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="KillXP" type="simple_uint32">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Kill Experience
Number of experience points the unit awards to its killer.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="Radius" type="simple_TUnitRadius">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Radius
Radius at which the unit can interact with other units]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="DeadRadius" type="simple_TUnitRadius">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Radius - Dead
Collision radius of the unit when it is dead]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="SeparationRadius" type="simple_CFixed">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Separation Radius
Distance between Air units in a squadron]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="InnerRadius" type="simple_TUnitRadius">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Inner Radius
Radius at which the unit can interact with buildings]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="DeadInnerRadius" type="simple_TUnitRadius">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Inner Radius While Dead
Radius at which the unit can interact with buildings when it is dead]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
