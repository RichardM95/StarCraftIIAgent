			<xs:extension base="CBase">
				<xs:choice minOccurs="0" maxOccurs="unbounded">
					<xs:element minOccurs="0" maxOccurs="1" name="UnitLink" type="CUnitLink">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Unit]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="unbounded" name="TacAbilData">
