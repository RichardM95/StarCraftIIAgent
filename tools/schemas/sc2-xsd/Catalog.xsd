	<xs:complexType name="EActorActionFlag">
		<xs:attribute name="value" type="simple_EActorActionFlag"/>
	</xs:complexType>
	<xs:simpleType name="simple_EActorActionFlag">
		<xs:restriction base="xs:string">
			<xs:enumeration value="AlignedImpactsAndDamages">
				<xs:annotation>
					<xs:documentation>
						<![CDATA[Align Impact And Damage
Used for beam attacks to ensure that subsequent damage pulses produce FX at the beam's impact position, which is where the beam first struck the target.]]>
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="IgnoresShields">
				<xs:annotation>
					<xs:documentation>
						<![CDATA[Ignores Shields
Causes attacks to bypass shields entirely.  The Viper's Consume beam is an example, since it drains health from the core building, not it's shields.]]>
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ImpactForceSite">
				<xs:annotation>
					<xs:documentation>
						<![CDATA[Impact Force Site
Forces the CActorAction to create a CActorSite at the impact position.  This enables multiple FX to easily share a single bearings for as long as any of the FX exist.]]>
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ImpactMonitorsTeleports">
				<xs:annotation>
					<xs:documentation>
						<![CDATA[Impact Monitors Teleports
Forces the CActorAction to remain alive at least as long as any impact-related beams or impact model FX that it has spawned remain alive.  This enables it to route ActionTargetTeleport messages to these actors, so they can be configured to kill themselves when a target has teleported far out of range.]]>
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ImpactSuppressUnitSound">
				<xs:annotation>
					<xs:documentation>
						<![CDATA[Impact Suppress Unit
Prevents the creation of the additional generic impact sound that is configured on the target CActorUnit.]]>
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="LaunchForceSite">
				<xs:annotation>
					<xs:documentation>
						<![CDATA[Launch Force Site
Forces the CActorAction to create a CActorSite at the launch position.  This enables multiple FX to easily share a single bearings for as long as any of the FX exist.]]>
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="VictimRevealsAttacker">
				<xs:annotation>
					<xs:documentation>
						<![CDATA[Victim Reveals Attacker
Marks the attack as temporarily revealing the attacker when a player can see the victim of the attack.  Useful for tentacles.  If a Viper that is under the fog of war Abducts a victim unit the player can see, it makes more sense visually for the victim unit's owner to be able to see the owner of the tentacle while this is happening.]]>
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
