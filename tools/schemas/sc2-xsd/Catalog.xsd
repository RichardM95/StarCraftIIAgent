					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MinimapTooltip">
				<xs:annotation>
					<xs:documentation>
						<![CDATA[Minimap Tooltip]]>
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Missile">
				<xs:annotation>
					<xs:documentation>
						<![CDATA[Missile]]>
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MissilePreHost">
				<xs:annotation>
					<xs:documentation>
						<![CDATA[Missile (Pre Host)]]>
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MissileTentacleRetracted">
				<xs:annotation>
					<xs:documentation>
						<![CDATA[Missile Tentacle Retracted]]>
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MissileTentacleReturn">
				<xs:annotation>
					<xs:documentation>
						<![CDATA[Tentacle Return]]>
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ModelAllowHitTest">
				<xs:annotation>
					<xs:documentation>
						<![CDATA[Model Allow Hit Test]]>
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ModelAnimateInvisible">
				<xs:annotation>
					<xs:documentation>
						<![CDATA[Model Animate Invisible]]>
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ModelAspectApplied">
				<xs:annotation>
					<xs:documentation>
						<![CDATA[Model Aspect Applied
Sent just after a new model aspect gets applied, and the new aspect model is swapped in.]]>
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ModelAspectConfirm">
				<xs:annotation>
					<xs:documentation>
						<![CDATA[Aspect Confirm
Target: CActorModel.  Enables data to confirm that a specific model aspect is to be chosen or not, based on whether it passes specific terms.]]>
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ModelAspectStart">
				<xs:annotation>
					<xs:documentation>
						<![CDATA[Model Aspect Start
Sent just before a new model aspect gets applied, and before the new aspect model is swapped in.  The ModelSwapped message can be used to configure the aspect model after it has been set.]]>
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ModelAspectStop">
				<xs:annotation>
					<xs:documentation>
						<![CDATA[Model Aspect Stop
Sent just before a model aspect is removed or gets replaced by a new model aspect.  The model that is about to be replaced is still live when this message is sent.]]>
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ModelAspectTest">
				<xs:annotation>
					<xs:documentation>
						<![CDATA[Aspect Test
Sent when a model aspect has the Message test type.  Enables data to use terms to filter model aspects.]]>
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ModelEvent">
				<xs:annotation>
					<xs:documentation>
						<![CDATA[Model Event]]>
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ModelEventSuppress">
				<xs:annotation>
					<xs:documentation>
						<![CDATA[Model Event Suppress]]>
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ModelFlagsClear">
				<xs:annotation>
					<xs:documentation>
						<![CDATA[Model Flags Clear]]>
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ModelFlagsSet">
				<xs:annotation>
					<xs:documentation>
						<![CDATA[Model Flags Set]]>
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ModelLinkCustomize">
				<xs:annotation>
					<xs:documentation>
						<![CDATA[Model Link Customize
Target: CActorModel.  Allows data to model swap before the initial model is created for better performance. Should be send in response to the AssetPreInit message.]]>
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ModelLinkCustomizeSpecial">
				<xs:annotation>
					<xs:documentation>
						<![CDATA[Model Link Customize Special
Target: CActorModel.  Allows data to model swap before the initial model is created for better performance. Actor will determine the best model link to use based on the specified type. Should be send in response to the AssetPreInit message.]]>
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ModelMaterialApply">
				<xs:annotation>
					<xs:documentation>
						<![CDATA[Model Material Apply
Target: CActorModel.  Creates and applies a CActorModelMaterial specified by the given name in the target CActorModel's scope.]]>
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ModelMaterialApplyTo">
				<xs:annotation>
					<xs:documentation>
						<![CDATA[Model Material Apply To
Target: CActorModelMaterial.  Applies the model material to the CActorModel specified by the supplied refName.  Can be used to apply the same CActorModelMaterial to more than one CActorModel simultaneously, thereby sharing the model material's animation across multiple models.]]>
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ModelMaterialDump">
				<xs:annotation>
					<xs:documentation>
						<![CDATA[Model Material Dump
Target: CActorModel.  Lists all materials currently being applied to the target CActorModel.]]>
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ModelMaterialMaximizePriority">
				<xs:annotation>
					<xs:documentation>
