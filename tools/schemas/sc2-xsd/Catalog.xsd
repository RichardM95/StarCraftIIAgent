			<xs:enumeration value="CenterActor">
				<xs:annotation>
					<xs:documentation>
						<![CDATA[Center Actor
The model stores itself in the proximity query system using its parent actor's position.]]>
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CenterModelBounds">
				<xs:annotation>
					<xs:documentation>
						<![CDATA[Center Model Bounds
The model stores itself in the proximity query system using the center of its model bounds.  Can produce more accurate query results when a model is very large and its model bounds center is quite distant from its actor's center.]]>
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
