	<xs:complexType name="CSound">
		<xs:complexContent>
			<xs:extension base="CBase">
				<xs:choice minOccurs="0" maxOccurs="unbounded">
					<xs:element minOccurs="0" maxOccurs="1" name="EditorCategories" type="TEditorCategories">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Editor Categories
Editor Categories are used for filtering and organization within the StarCraft II Editor.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="unbounded" name="AssetArray">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Sound Assets
Specifies the set of assets that are included in the sound.]]>
							</xs:documentation>
						</xs:annotation>
						<xs:complexType>
							<xs:complexContent>
								<xs:extension base="SSoundAsset">
									<xs:attribute name="index" type="simple_indexIntOrName"/>
									<xs:attribute name="removed" type="simple_bool"/>
								</xs:extension>
							</xs:complexContent>
						</xs:complexType>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="unbounded" name="Flags">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Flags
Configures various options for the sound.]]>
							</xs:documentation>
						</xs:annotation>
						<xs:complexType>
							<xs:complexContent>
								<xs:extension base="bool">
									<xs:attribute name="index" type="simple_ESoundFlag"/>
									<xs:attribute name="removed" type="simple_bool"/>
								</xs:extension>
							</xs:complexContent>
						</xs:complexType>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="Category" type="ESoundCategory">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Group
Assigns the sound to an FMOD channel group that can have a volume, paused, and muted status that is combined with individual sounds.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="Chance" type="uint8">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Chance
Specifies a percentage chance that a sound will actually create a voice when you request to play it. Defaults to 100%.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="ConeAngle" type="CRange">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Cone Angle
Configures the FMOD channel cone parameters. Only applicable to 3D sounds; relative to the sound position in the world.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="ConeOrientation" type="C3Vector">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Cone Orientation
Configures the FMOD channel cone parameters. Only applicable to 3D sounds; relative to the sound position in the world.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="ConeVolume" type="CRange">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Cone Volume
Configures the FMOD channel cone parameters. Only applicable to 3D sounds; relative to the sound position in the world.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="DopplerLevel" type="real32">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Doppler Level
Configures the FMOD channel doppler parameter. Only applicable to 3D sounds. Related to the doppler factor specified in the terrain data for a map.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="DupeDestroyCount" type="uint16">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Max Voice Count - Destroy
Specifies the maximum instances of a sound that may be created before the least important voice is destroyed or when we stop creating new sounds (depends on the dupe maximum method).]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="DupeFadeBlend" type="ESoundBlend">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Dupe Fade Blend
Specifies a fade curve to use when a voice becomes or is no longer considered a duplicate.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="unbounded" name="DupeFadeIn">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Duplicate Fade In
Specifies a fade curve to use when a voice becomes a duplicate.]]>
							</xs:documentation>
						</xs:annotation>
						<xs:complexType>
							<xs:complexContent>
								<xs:extension base="SVolumeFade">
									<xs:attribute name="index" type="simple_indexIntOrName"/>
									<xs:attribute name="removed" type="simple_bool"/>
								</xs:extension>
							</xs:complexContent>
						</xs:complexType>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="unbounded" name="DupeFadeOut">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Duplicate Fade Out
Specifies a fade curve to use when a voice is no longer considered a duplicate.]]>
							</xs:documentation>
						</xs:annotation>
						<xs:complexType>
							<xs:complexContent>
								<xs:extension base="SVolumeFade">
									<xs:attribute name="index" type="simple_indexIntOrName"/>
									<xs:attribute name="removed" type="simple_bool"/>
								</xs:extension>
							</xs:complexContent>
						</xs:complexType>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="DupeHistoryCount" type="uint16">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Dupe History Count
Specifies how many instances we track of a sound when it is done playing. Used primarily for sound selection when playing a new sound. For Random, we use the history to determine the last sound that played so we can avoid repeating that one.  For Shuffle, we use the history to find the least played subset and do a weighted randomization to select between them.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="DupeMaximumMethod" type="ESoundDupe">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Dupe Maximum Method
Specifies how the sound engine handles the situation when the maximum number of duplicate sounds have been played.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="DupeMuteCount" type="uint16">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Max Voice Count - Mute
Specifies how many instances of a sound that may be created before the least important voice is muted.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="DupeRepeatCount" type="uint16">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Max Asset Repeat Count
Specifies how many repeated instances of a specific asset are permitted, even if they aren't overlapping. The least important instances beyond this count will be silenced.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="DupeThresholdFadeTime" type="uint32">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Duplicate Threshold Fade Time
Specifies the fading behavior when a threshold of sounds for a category has been reached or is no longer present.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="unbounded" name="DupeThresholdPoints">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Duplicate Threshold Points
Specifies the fading behavior when a threshold of sounds for a category has been reached or is no longer present.]]>
							</xs:documentation>
						</xs:annotation>
						<xs:complexType>
							<xs:complexContent>
								<xs:extension base="SVolumeThreshold">
									<xs:attribute name="index" type="simple_indexIntOrName"/>
									<xs:attribute name="removed" type="simple_bool"/>
								</xs:extension>
							</xs:complexContent>
						</xs:complexType>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="DupeWait" type="CiRange">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Duplicate Wait
Specifies how long after a sound is played before another is allowed to play in its audible range. Primarily used for creep sounds. This value may be randomized by picking a lower and upper bounds.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="FogFadeBlend" type="ESoundBlend">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Fog Fade Blend
Specifies the fade curve to use when a 3D sound becomes fogged or unfogged.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="unbounded" name="FogFadeIn">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Fog Fade In
Specifies the fade curve to use when a 3D sound becomes unfogged.]]>
							</xs:documentation>
						</xs:annotation>
						<xs:complexType>
							<xs:complexContent>
								<xs:extension base="SVolumeFade">
									<xs:attribute name="index" type="simple_indexIntOrName"/>
									<xs:attribute name="removed" type="simple_bool"/>
								</xs:extension>
							</xs:complexContent>
						</xs:complexType>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="unbounded" name="FogFadeOut">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Fog Fade Out
Specifies the fade curve to use when a 3D sound becomes fogged.]]>
							</xs:documentation>
						</xs:annotation>
						<xs:complexType>
							<xs:complexContent>
								<xs:extension base="SVolumeFade">
									<xs:attribute name="index" type="simple_indexIntOrName"/>
									<xs:attribute name="removed" type="simple_bool"/>
								</xs:extension>
							</xs:complexContent>
						</xs:complexType>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="HerdNode" type="CHerdNodeLink">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Herd Node]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="unbounded" name="LocaleFlags">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Locale Flags
Only used by the editor to indicate production tracking status on localization.]]>
							</xs:documentation>
						</xs:annotation>
						<xs:complexType>
							<xs:complexContent>
								<xs:extension base="SSoundLocaleFlags">
									<xs:attribute name="index" type="simple_indexIntOrName"/>
									<xs:attribute name="removed" type="simple_bool"/>
								</xs:extension>
							</xs:complexContent>
						</xs:complexType>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="LoopCount" type="int32">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Loop Count
Specifies the number of times that a sound set will repeat. This will cause it to loop over all available assets based on their selection mode (shuffle or sequential). Specify -1 here to indicate you want it to loop infinitely. Note that loop points need to be configured per-asset, if applicable.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="LoopDelay" type="CiRange">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Loop Delay]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="LowPassGain" type="real32">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Low Pass Gain
Configures the FMOD channel low pass gain parameter (sets the gain of the dry signal when lowpass filtering is applied).]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="Mode" type="ESoundMode">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Mode
Indicates if the sound should be configured as 2D, 3D (Head Relative), or 3D (World Relative). Sounds that are configured as 2D do not have a fog test performed. Generally 2D sounds should be reserved to map-wide audio like the ambience soundtrack or UI sounds. If a sound is configured as a 3D world-relative sound but does not have a valid position, it will be converted to a 3D head-relative sound.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="MuteFadeBlend" type="ESoundBlend">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Mute Fade Blend
Specifies the fade behavior when a sound is muted or unmuted.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="unbounded" name="MuteFadeIn">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Mute Fade In
Specifies the fade behavior when a sound is muted.]]>
							</xs:documentation>
						</xs:annotation>
						<xs:complexType>
							<xs:complexContent>
								<xs:extension base="SVolumeFade">
									<xs:attribute name="index" type="simple_indexIntOrName"/>
									<xs:attribute name="removed" type="simple_bool"/>
								</xs:extension>
							</xs:complexContent>
						</xs:complexType>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="unbounded" name="MuteFadeOut">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Mute Fade Out
Specifies the fade behavior when a sound is unmuted.]]>
							</xs:documentation>
						</xs:annotation>
						<xs:complexType>
							<xs:complexContent>
								<xs:extension base="SVolumeFade">
									<xs:attribute name="index" type="simple_indexIntOrName"/>
									<xs:attribute name="removed" type="simple_bool"/>
								</xs:extension>
							</xs:complexContent>
						</xs:complexType>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="OcclusionDirect" type="CRange">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Occlusion (Direct)
Configures the occlusion factors for a channel. Only applicable to 3D sounds. We don't have FMOD geometry objects, so this is the only way to reproduce that kind of behavior. This value may be randomized by picking a lower and upper bounds.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="OcclusionReverb" type="CRange">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Occlusion (Reverb)
Configures the occlusion factors for a channel. Only applicable to 3D sounds. We don't have FMOD geometry objects, so this is the only way to reproduce that kind of behavior. This value may be randomized by picking a lower and upper bounds.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="OffsetFadeBlend" type="ESoundBlend">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Offset Fade Blend
Specifies the fade in and fade out curve for a sound. The times are relative to the overall sound length including looping.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="unbounded" name="OffsetFadeIn">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Offset Fade In
Specifies the fade in curve for a sound. The times are relative to the overall sound length including looping.]]>
							</xs:documentation>
						</xs:annotation>
						<xs:complexType>
							<xs:complexContent>
								<xs:extension base="SVolumeFade">
									<xs:attribute name="index" type="simple_indexIntOrName"/>
									<xs:attribute name="removed" type="simple_bool"/>
								</xs:extension>
							</xs:complexContent>
						</xs:complexType>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="unbounded" name="OffsetFadeOut">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Offset Fade Out
Specifies the fade out curve for a sound. The times are relative to the overall sound length including looping.]]>
							</xs:documentation>
						</xs:annotation>
						<xs:complexType>
							<xs:complexContent>
								<xs:extension base="SVolumeFade">
									<xs:attribute name="index" type="simple_indexIntOrName"/>
									<xs:attribute name="removed" type="simple_bool"/>
								</xs:extension>
							</xs:complexContent>
						</xs:complexType>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="OffsetShiftBlend" type="ESoundBlend">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Offset Shift Blend
Specifies the pitch shift in and out curve for a sound. The times are relative to the overall sound length including looping.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="unbounded" name="OffsetShiftIn">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Offset Shift In
Specifies the pitch shift in curve for a sound. The times are relative to the overall sound length including looping.]]>
							</xs:documentation>
						</xs:annotation>
						<xs:complexType>
							<xs:complexContent>
								<xs:extension base="SPitchShift">
									<xs:attribute name="index" type="simple_indexIntOrName"/>
									<xs:attribute name="removed" type="simple_bool"/>
								</xs:extension>
							</xs:complexContent>
						</xs:complexType>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="unbounded" name="OffsetShiftOut">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Offset Shift Out
Specifies the pitch shift out curve for a sound. The times are relative to the overall sound length including looping.]]>
							</xs:documentation>
						</xs:annotation>
						<xs:complexType>
							<xs:complexContent>
								<xs:extension base="SPitchShift">
									<xs:attribute name="index" type="simple_indexIntOrName"/>
									<xs:attribute name="removed" type="simple_bool"/>
								</xs:extension>
							</xs:complexContent>
						</xs:complexType>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="OverlapPitchDelta" type="real32">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Overlap Pitch Delta
Specifies the threshold for comparing two instances of the same asset to determine if they are overlapping (in which case the least important sounds are muted). Note that the pitch value refers to the Pitch data value, not the actual pitch of the waveform.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="OverlapTimeDelta" type="uint16">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Overlap Time Delta
Specifies the threshold for comparing two instances of the same asset to determine if they are overlapping (in which case the least important sounds are muted). Note that the pitch value refers to the Pitch data value, not the actual pitch of the waveform.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="Pan" type="CRange">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[2D Pan
Specifies the speaker pan amount for 2D sounds. -1 = full left, +1 = full right, 0 = center. Defaults to 0. This value may be randomized by picking a lower and upper bounds.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="PanLevel" type="real32">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[3D Pan Level
Configures the FMOD channel 3D pan level parameter (sets how much the 3d engine has an effect on the channel, versus that set by Pan or Speaker Mix).  0 is 100% using the Speaker Mix values and not using the 3D engine at all.  1 is 100% using the 3D engine and not using the Speaker Mix values at all.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="Pitch" type="CPitchRange">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Pitch (semitones)
Specifies a frequency shift for the sound. This is not a true octave shift, although there is a DSP (which is expensive) that can be applied to accomplish that. This value may be randomized by picking a lower and upper bounds.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="ResourcePriority" type="uint8">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Resource Priority
Used by the resource management system to determine how important this sound is to load and keep in memory.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="ReverbBalance" type="SReverbBalance">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Reverb Balance
Configures the default reverb direct and room levels.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="ReverbRolloffBlend" type="ESoundBlend">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Reverb Rolloff Blend
Controls how much the default reverb levels are affected by a sound's distance from the listener.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="unbounded" name="ReverbRolloffPoints">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Reverb Rolloff Points
Controls how much the default reverb levels are affected by a sound's distance from the listener.]]>
							</xs:documentation>
						</xs:annotation>
						<xs:complexType>
							<xs:complexContent>
								<xs:extension base="SReverbRolloff">
									<xs:attribute name="index" type="simple_indexIntOrName"/>
									<xs:attribute name="removed" type="simple_bool"/>
								</xs:extension>
							</xs:complexContent>
						</xs:complexType>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="Select" type="ESoundSelect">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Select
Specifies the way that we cycle through sounds in a set when looping over all assets or playing multiple instances of the same sound. Sequential means that we will play each of the assets in the sound before repeating. Shuffle means that we will randomly select assets until all of the assets have been played and then we will choose a new playlist. The same sound will never play back-to-back unless there is only one asset, or the same asset is in the set multiple times.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="unbounded" name="SpeakerMix">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Speaker Mix
Configures the FMOD channel speaker mix per speaker. The most commonly adjusted setting here is adjusting the LFE volume for 3D sounds.]]>
							</xs:documentation>
						</xs:annotation>
						<xs:complexType>
							<xs:complexContent>
								<xs:extension base="real32">
									<xs:attribute name="index" type="simple_ESpeaker"/>
									<xs:attribute name="removed" type="simple_bool"/>
								</xs:extension>
							</xs:complexContent>
						</xs:complexType>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="Spread" type="real32">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[3D Stereo Spread (degrees)
Configures the FMOD channel 3D spread setting in speaker space. When increasing the spread of a sound, the left and right parts of a stereo sound rotate away from their original position to give it more "stereoness".  Mono sounds can also be "spread" with this parameter.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="SustainFadeBlend" type="ESoundBlend">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Sustain Fade Blend
Specifies the fade behavior when a sound is interrupted (usually by scripts or other gameplay).]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="unbounded" name="SustainFade">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Sustain Fade
Specifies the fade behavior when a sound is interrupted (usually by scripts or other gameplay).]]>
							</xs:documentation>
						</xs:annotation>
						<xs:complexType>
							<xs:complexContent>
								<xs:extension base="SVolumeFade">
									<xs:attribute name="index" type="simple_indexIntOrName"/>
									<xs:attribute name="removed" type="simple_bool"/>
								</xs:extension>
							</xs:complexContent>
						</xs:complexType>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="Timeout" type="uint32">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Timeout
Specifies the amount of time that we wait for a sound to load (and maybe download) before we give up and cancel the request. Useful for making sure sounds don't play long after they are relevant.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="VariationMinimum" type="uint32">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Variation Minimum
Specifies the minimum number of assets from a sound that must be available regardless of the sound quality setting in the sound options panel.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="Volume" type="CVolumeRange">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Volume (dBFS)
Configures the ideal volume of a sound without any mixing or fading applied. This value may be randomized by picking a lower and upper bounds. This value is multiplied by the per-asset volume.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="VolumeRolloffBlend" type="ESoundBlend">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Volume Rolloff Blend
Specifies the volume adjustment behavior for 3D sounds based on the listener position.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="VolumeRolloffFadeBlend" type="ESoundBlend">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Volume Rolloff Fade Blend
Specifies the volume adjustment behavior for 3D sounds based on the listener position.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="unbounded" name="VolumeRolloffFadeIn">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Volume Rolloff Fade In
Specifies the volume adjustment behavior for 3D sounds based on the listener position.]]>
							</xs:documentation>
						</xs:annotation>
						<xs:complexType>
							<xs:complexContent>
								<xs:extension base="SVolumeFade">
									<xs:attribute name="index" type="simple_indexIntOrName"/>
									<xs:attribute name="removed" type="simple_bool"/>
								</xs:extension>
							</xs:complexContent>
						</xs:complexType>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="unbounded" name="VolumeRolloffFadeOut">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Volume Rolloff Fade Out
Specifies the volume adjustment behavior for 3D sounds based on the listener position.]]>
							</xs:documentation>
						</xs:annotation>
						<xs:complexType>
							<xs:complexContent>
								<xs:extension base="SVolumeFade">
									<xs:attribute name="index" type="simple_indexIntOrName"/>
									<xs:attribute name="removed" type="simple_bool"/>
								</xs:extension>
							</xs:complexContent>
						</xs:complexType>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="unbounded" name="VolumeRolloffPoints">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Volume Rolloff Points
Specifies the volume adjustment behavior for 3D sounds based on the listener position.]]>
							</xs:documentation>
						</xs:annotation>
						<xs:complexType>
							<xs:complexContent>
								<xs:extension base="SVolumeRolloff">
									<xs:attribute name="index" type="simple_indexIntOrName"/>
									<xs:attribute name="removed" type="simple_bool"/>
								</xs:extension>
							</xs:complexContent>
						</xs:complexType>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="AssetArrayTemplate" type="SSoundAssetTemplate">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Asset Array Template]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="CategoryLocal" type="ESoundCategory">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Group Local
The category to use for this sound if the player is the local (observed) player.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="DupeDestroyCountPerPlayer" type="uint16">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Max Voice Count Per Player - Destroy]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="DupeMuteCountPerPlayer" type="uint16">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Max Voice Count Per Player - Mute]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="DupePrioritization" type="ESoundDupePriority">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Dupe Prioritization
This determines the order that duplicate sounds are destroyed in.  Default = mixer priority, distance, audibility.  Oldest = Oldest Destroyed First.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="Exclusivity" type="CSoundExclusivityLink">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Sound Exclusivity
Determines whether this sound can be prevented from playing, or delayed, due to other sounds currently being played.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="MixerPriority" type="int16">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Mixer Priority
A sound with a higher priority than another sound will not be stolen or made virtual by that sound. 0 = most important. 256 = least important. A value of -1 means to use the mixer priority of the sound category for this sound.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="MixerPriorityNonLocal" type="int16">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Mixer Priority (Non Local)
Mixer priority to use for non local sounds. A value of -1 means to use the same priority as local sounds.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="Mute" type="bool">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Mute]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="PanLevelNonLocal" type="real32">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[3D Pan Level (Non Local)
The pan level to use for non local sounds. Less than zero means to use the value in pan level.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="PlayDelay" type="CiRange">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Play Delay
How long to delay playing this sound (in ms)]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="PositionRandomOffset" type="C3Vector">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Position Random Offset
The position of the sound will be randomly offset by up to this amount either positively or negatively.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="PositionRandomOffsetPower" type="real32">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Position Random Offset Power
This is used to modify the distribution of the random offset.  The percentage offset on each axis (0..1) is taken to this power.  Less than 1 means that points will tend to be more towards the edges.  Greater than one 1 means the points will tend to be more towards the center.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="Solo" type="bool">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Solo]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="unbounded" name="SpeakerMixNonLocal">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Speaker Mix (Non Local)
The speaker mix to use if this sound is played for a non local player. -1 means to use the value in SpeakerMix.]]>
							</xs:documentation>
						</xs:annotation>
						<xs:complexType>
							<xs:complexContent>
								<xs:extension base="real32">
									<xs:attribute name="index" type="simple_indexIntOrName"/>
									<xs:attribute name="removed" type="simple_bool"/>
								</xs:extension>
							</xs:complexContent>
						</xs:complexType>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="LocalVolumeAdjustment" type="CVolumeRange">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Local Volume Adjustment
Applies a volume adjustment when the sound is played owned by the local player.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="NonLocalVolumeAdjustment" type="CVolumeRange">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Non Local Volume Adjustment
Applies a volume adjustment when the sound is played not owned by the local player.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="CategoryDuckingLocal" type="CSoundMixSnapshotLink">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Category Ducking Local
A sound mix snapshot to use for category ducking when this sound plays as a local sound.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="CategoryDuckingNonLocal" type="CSoundMixSnapshotLink">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Category Ducking Non Local
A sound mix snapshot to use for category ducking when this sound plays as a non local sound.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:choice>
				<xs:attribute name="EditorCategories" type="simple_TEditorCategories">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Editor Categories
Editor Categories are used for filtering and organization within the StarCraft II Editor.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="Category" type="simple_ESoundCategory">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Group
Assigns the sound to an FMOD channel group that can have a volume, paused, and muted status that is combined with individual sounds.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="Chance" type="simple_uint8">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Chance
Specifies a percentage chance that a sound will actually create a voice when you request to play it. Defaults to 100%.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="ConeAngle" type="simple_CRange">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Cone Angle
Configures the FMOD channel cone parameters. Only applicable to 3D sounds; relative to the sound position in the world.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="ConeOrientation" type="simple_C3Vector">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Cone Orientation
Configures the FMOD channel cone parameters. Only applicable to 3D sounds; relative to the sound position in the world.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="ConeVolume" type="simple_CRange">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Cone Volume
Configures the FMOD channel cone parameters. Only applicable to 3D sounds; relative to the sound position in the world.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="DopplerLevel" type="simple_real32">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Doppler Level
Configures the FMOD channel doppler parameter. Only applicable to 3D sounds. Related to the doppler factor specified in the terrain data for a map.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="DupeDestroyCount" type="simple_uint16">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Max Voice Count - Destroy
Specifies the maximum instances of a sound that may be created before the least important voice is destroyed or when we stop creating new sounds (depends on the dupe maximum method).]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="DupeFadeBlend" type="simple_ESoundBlend">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Dupe Fade Blend
Specifies a fade curve to use when a voice becomes or is no longer considered a duplicate.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="DupeHistoryCount" type="simple_uint16">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Dupe History Count
Specifies how many instances we track of a sound when it is done playing. Used primarily for sound selection when playing a new sound. For Random, we use the history to determine the last sound that played so we can avoid repeating that one.  For Shuffle, we use the history to find the least played subset and do a weighted randomization to select between them.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="DupeMaximumMethod" type="simple_ESoundDupe">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Dupe Maximum Method
Specifies how the sound engine handles the situation when the maximum number of duplicate sounds have been played.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="DupeMuteCount" type="simple_uint16">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Max Voice Count - Mute
Specifies how many instances of a sound that may be created before the least important voice is muted.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="DupeRepeatCount" type="simple_uint16">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Max Asset Repeat Count
Specifies how many repeated instances of a specific asset are permitted, even if they aren't overlapping. The least important instances beyond this count will be silenced.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="DupeThresholdFadeTime" type="simple_uint32">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Duplicate Threshold Fade Time
Specifies the fading behavior when a threshold of sounds for a category has been reached or is no longer present.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="DupeWait" type="simple_CiRange">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Duplicate Wait
Specifies how long after a sound is played before another is allowed to play in its audible range. Primarily used for creep sounds. This value may be randomized by picking a lower and upper bounds.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="FogFadeBlend" type="simple_ESoundBlend">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Fog Fade Blend
Specifies the fade curve to use when a 3D sound becomes fogged or unfogged.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="HerdNode" type="simple_CHerdNodeLink">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Herd Node]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="LoopCount" type="simple_int32">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Loop Count
Specifies the number of times that a sound set will repeat. This will cause it to loop over all available assets based on their selection mode (shuffle or sequential). Specify -1 here to indicate you want it to loop infinitely. Note that loop points need to be configured per-asset, if applicable.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="LoopDelay" type="simple_CiRange">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Loop Delay]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="LowPassGain" type="simple_real32">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Low Pass Gain
Configures the FMOD channel low pass gain parameter (sets the gain of the dry signal when lowpass filtering is applied).]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="Mode" type="simple_ESoundMode">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Mode
Indicates if the sound should be configured as 2D, 3D (Head Relative), or 3D (World Relative). Sounds that are configured as 2D do not have a fog test performed. Generally 2D sounds should be reserved to map-wide audio like the ambience soundtrack or UI sounds. If a sound is configured as a 3D world-relative sound but does not have a valid position, it will be converted to a 3D head-relative sound.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="MuteFadeBlend" type="simple_ESoundBlend">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Mute Fade Blend
Specifies the fade behavior when a sound is muted or unmuted.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="OcclusionDirect" type="simple_CRange">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Occlusion (Direct)
Configures the occlusion factors for a channel. Only applicable to 3D sounds. We don't have FMOD geometry objects, so this is the only way to reproduce that kind of behavior. This value may be randomized by picking a lower and upper bounds.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="OcclusionReverb" type="simple_CRange">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Occlusion (Reverb)
Configures the occlusion factors for a channel. Only applicable to 3D sounds. We don't have FMOD geometry objects, so this is the only way to reproduce that kind of behavior. This value may be randomized by picking a lower and upper bounds.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="OffsetFadeBlend" type="simple_ESoundBlend">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Offset Fade Blend
Specifies the fade in and fade out curve for a sound. The times are relative to the overall sound length including looping.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="OffsetShiftBlend" type="simple_ESoundBlend">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Offset Shift Blend
Specifies the pitch shift in and out curve for a sound. The times are relative to the overall sound length including looping.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="OverlapPitchDelta" type="simple_real32">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Overlap Pitch Delta
Specifies the threshold for comparing two instances of the same asset to determine if they are overlapping (in which case the least important sounds are muted). Note that the pitch value refers to the Pitch data value, not the actual pitch of the waveform.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="OverlapTimeDelta" type="simple_uint16">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Overlap Time Delta
Specifies the threshold for comparing two instances of the same asset to determine if they are overlapping (in which case the least important sounds are muted). Note that the pitch value refers to the Pitch data value, not the actual pitch of the waveform.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="Pan" type="simple_CRange">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[2D Pan
Specifies the speaker pan amount for 2D sounds. -1 = full left, +1 = full right, 0 = center. Defaults to 0. This value may be randomized by picking a lower and upper bounds.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="PanLevel" type="simple_real32">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[3D Pan Level
Configures the FMOD channel 3D pan level parameter (sets how much the 3d engine has an effect on the channel, versus that set by Pan or Speaker Mix).  0 is 100% using the Speaker Mix values and not using the 3D engine at all.  1 is 100% using the 3D engine and not using the Speaker Mix values at all.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="Pitch" type="simple_CPitchRange">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Pitch (semitones)
Specifies a frequency shift for the sound. This is not a true octave shift, although there is a DSP (which is expensive) that can be applied to accomplish that. This value may be randomized by picking a lower and upper bounds.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="ResourcePriority" type="simple_uint8">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Resource Priority
Used by the resource management system to determine how important this sound is to load and keep in memory.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="ReverbRolloffBlend" type="simple_ESoundBlend">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Reverb Rolloff Blend
Controls how much the default reverb levels are affected by a sound's distance from the listener.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="Select" type="simple_ESoundSelect">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Select
Specifies the way that we cycle through sounds in a set when looping over all assets or playing multiple instances of the same sound. Sequential means that we will play each of the assets in the sound before repeating. Shuffle means that we will randomly select assets until all of the assets have been played and then we will choose a new playlist. The same sound will never play back-to-back unless there is only one asset, or the same asset is in the set multiple times.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="Spread" type="simple_real32">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[3D Stereo Spread (degrees)
Configures the FMOD channel 3D spread setting in speaker space. When increasing the spread of a sound, the left and right parts of a stereo sound rotate away from their original position to give it more "stereoness".  Mono sounds can also be "spread" with this parameter.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="SustainFadeBlend" type="simple_ESoundBlend">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Sustain Fade Blend
Specifies the fade behavior when a sound is interrupted (usually by scripts or other gameplay).]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="Timeout" type="simple_uint32">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Timeout
Specifies the amount of time that we wait for a sound to load (and maybe download) before we give up and cancel the request. Useful for making sure sounds don't play long after they are relevant.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="VariationMinimum" type="simple_uint32">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Variation Minimum
Specifies the minimum number of assets from a sound that must be available regardless of the sound quality setting in the sound options panel.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="Volume" type="simple_CVolumeRange">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Volume (dBFS)
Configures the ideal volume of a sound without any mixing or fading applied. This value may be randomized by picking a lower and upper bounds. This value is multiplied by the per-asset volume.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="VolumeRolloffBlend" type="simple_ESoundBlend">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Volume Rolloff Blend
Specifies the volume adjustment behavior for 3D sounds based on the listener position.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="VolumeRolloffFadeBlend" type="simple_ESoundBlend">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Volume Rolloff Fade Blend
Specifies the volume adjustment behavior for 3D sounds based on the listener position.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="CategoryLocal" type="simple_ESoundCategory">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Group Local
The category to use for this sound if the player is the local (observed) player.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="DupeDestroyCountPerPlayer" type="simple_uint16">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Max Voice Count Per Player - Destroy]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="DupeMuteCountPerPlayer" type="simple_uint16">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Max Voice Count Per Player - Mute]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="DupePrioritization" type="simple_ESoundDupePriority">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Dupe Prioritization
This determines the order that duplicate sounds are destroyed in.  Default = mixer priority, distance, audibility.  Oldest = Oldest Destroyed First.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="Exclusivity" type="simple_CSoundExclusivityLink">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Sound Exclusivity
Determines whether this sound can be prevented from playing, or delayed, due to other sounds currently being played.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="MixerPriority" type="simple_int16">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Mixer Priority
A sound with a higher priority than another sound will not be stolen or made virtual by that sound. 0 = most important. 256 = least important. A value of -1 means to use the mixer priority of the sound category for this sound.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="MixerPriorityNonLocal" type="simple_int16">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Mixer Priority (Non Local)
Mixer priority to use for non local sounds. A value of -1 means to use the same priority as local sounds.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="Mute" type="simple_bool">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Mute]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="PanLevelNonLocal" type="simple_real32">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[3D Pan Level (Non Local)
The pan level to use for non local sounds. Less than zero means to use the value in pan level.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="PlayDelay" type="simple_CiRange">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Play Delay
How long to delay playing this sound (in ms)]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="PositionRandomOffset" type="simple_C3Vector">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Position Random Offset
The position of the sound will be randomly offset by up to this amount either positively or negatively.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="PositionRandomOffsetPower" type="simple_real32">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Position Random Offset Power
This is used to modify the distribution of the random offset.  The percentage offset on each axis (0..1) is taken to this power.  Less than 1 means that points will tend to be more towards the edges.  Greater than one 1 means the points will tend to be more towards the center.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="Solo" type="simple_bool">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Solo]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="LocalVolumeAdjustment" type="simple_CVolumeRange">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Local Volume Adjustment
Applies a volume adjustment when the sound is played owned by the local player.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="NonLocalVolumeAdjustment" type="simple_CVolumeRange">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Non Local Volume Adjustment
Applies a volume adjustment when the sound is played not owned by the local player.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="CategoryDuckingLocal" type="simple_CSoundMixSnapshotLink">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Category Ducking Local
A sound mix snapshot to use for category ducking when this sound plays as a local sound.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="CategoryDuckingNonLocal" type="simple_CSoundMixSnapshotLink">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Category Ducking Non Local
A sound mix snapshot to use for category ducking when this sound plays as a non local sound.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="CSoundtrack">
		<xs:complexContent>
			<xs:extension base="CBase">
				<xs:choice minOccurs="0" maxOccurs="unbounded">
					<xs:element minOccurs="0" maxOccurs="unbounded" name="CueArray">
