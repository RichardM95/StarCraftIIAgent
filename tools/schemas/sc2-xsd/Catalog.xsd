						<xs:annotation>
							<xs:documentation>
								<![CDATA[Inherit Type
Determines how this actor gets properties from its host.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="unbounded" name="Inherits">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Inherited Properties
Properties this actor inherits from its host actor]]>
