					<xs:annotation>
						<xs:documentation>
							<![CDATA[Cargo Overlap Filters
Specifies a set of filters to use when unloading this unit from a transport to decide what units near the unload location should be ignored.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="CargoSize" type="simple_TCargoSize">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Cargo Size
Number of cargo slots for the unit]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="Footprint" type="simple_CFootprintLink">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Pathing Footprint
Footprint used by the unit.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="DeadFootprint" type="simple_CFootprintLink">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Pathing Footprint - Dead
Pathing footprint of the unit when it is dead]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="PlacementFootprint" type="simple_CFootprintLink">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Pathing Footprint - Placement
Footprint of the unit for the placement grid]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="AddOnOffsetX" type="simple_CFixed">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Add On Offset X
Offset position from the host building along the X-axis at which the add-on appears]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="AddOnOffsetY" type="simple_CFixed">
					<xs:annotation>
						<xs:documentation>
