								</xs:extension>
							</xs:complexContent>
						</xs:complexType>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="Delay" type="CiRange">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Delay
Delay time between songs in the soundtrack]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="unbounded" name="Flags">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Flags
Flags for the soundtrack item.]]>
							</xs:documentation>
						</xs:annotation>
						<xs:complexType>
							<xs:complexContent>
								<xs:extension base="bool">
									<xs:attribute name="index" type="simple_ESoundtrackFlag"/>
