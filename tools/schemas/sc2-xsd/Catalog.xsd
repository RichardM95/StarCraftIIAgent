							<xs:documentation>
								<![CDATA[Ability
Ability order issued to the unit by the tactical order.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="AbilCmdIndex" type="TAbilCmdIndex">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Ability Command
The index of the chosen ability entry that is sent to the unit.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="Marker" type="SMarker">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Marker]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="Retreat" type="bool">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Retreat]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="TargetFind" type="CTargetFindLink">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Target Find]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="Validator" type="CValidatorLink">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Validator
Validator run against the order being issued.]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:choice>
				<xs:attribute name="Abil" type="simple_CAbilLink">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Ability
Ability order issued to the unit by the tactical order.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="AbilCmdIndex" type="simple_TAbilCmdIndex">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Ability Command
The index of the chosen ability entry that is sent to the unit.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="Retreat" type="simple_bool">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Retreat]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="TargetFind" type="simple_CTargetFindLink">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Target Find]]>
						</xs:documentation>
