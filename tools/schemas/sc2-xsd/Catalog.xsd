				<xs:attribute name="ScaleDamageMin" type="simple_real32">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Scale Damage Minimum
The minimum amount of damage that corresponds to the minimum radius value. The scale of the shield ripple is calculated by comparing the damaged received with the minimum and maximum damage values and applying that ratio to the minimum and maximum radius.]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
