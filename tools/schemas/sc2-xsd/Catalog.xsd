	</xs:complexType>
	<xs:simpleType name="simple_EActorQuadDecorationFlag">
		<xs:restriction base="xs:string">
			<xs:enumeration value="UseLaunchActorScale">
				<xs:annotation>
					<xs:documentation>
						<![CDATA[Use Launch Actor Scale
If true, the decoration will use the scale of the launch actor.]]>
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="EActorQuadDecorationFunction">
		<xs:attribute name="value" type="simple_EActorQuadDecorationFunction"/>
	</xs:complexType>
	<xs:simpleType name="simple_EActorQuadDecorationFunction">
		<xs:restriction base="xs:string">
			<xs:enumeration value="Bias">
				<xs:annotation>
					<xs:documentation>
						<![CDATA[Bias
Uses the Bias function to travel from point A to point B. A bias parameter value of 0.5 is linear.  A value greater than 0.5 will start fast and end slow.  A value less than 0.5 will start slow and end fast.]]>
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Gain">
				<xs:annotation>
					<xs:documentation>
						<![CDATA[Gain
Uses the Gain function to travel from point A to point B. A gain parameter value of 0.5 is linear.  A value greater than 0.5 will be fast on the ends and slow in the middle.  A value less than 0.5 will be slow on the ends and fast in the middle.]]>
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Linear">
				<xs:annotation>
					<xs:documentation>
						<![CDATA[Linear
Travels linearly from point A to point B]]>
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="EActorQuadFlag">
		<xs:attribute name="value" type="simple_EActorQuadFlag"/>
	</xs:complexType>
	<xs:simpleType name="simple_EActorQuadFlag">
		<xs:restriction base="xs:string">
			<xs:enumeration value="AlignVerticallyOnOrigin">
				<xs:annotation>
					<xs:documentation>
						<![CDATA[Align Vertically On Origin
Causes the quad to get its height from the origin of the quad, rather than the terrain height at the quad's center.]]>
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ForwardAnimMsgsCenterActor">
				<xs:annotation>
					<xs:documentation>
						<![CDATA[Forward Anim Messages to Center Actors
If true, any animation messages the quad actor receives will be passed onto the center actor.]]>
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ForwardAnimMsgsDecorationActor">
				<xs:annotation>
					<xs:documentation>
						<![CDATA[Forward Messages To Decoration Actor
If true, any animation messages the quad actor receives will be passed onto the decoration actor.]]>
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ForwardAnimMsgsImpactActor">
				<xs:annotation>
					<xs:documentation>
						<![CDATA[Forward Anim Messages to Impact Actor
If true, any animation messages the quad actor receives will be passed onto the impact actor.]]>
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ForwardAnimMsgsLaunchActor">
				<xs:annotation>
					<xs:documentation>
						<![CDATA[Forward Anim Messages to Launch Actor
If true, any animation messages the quad actor receives will be passed onto the launch actor.]]>
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="IgnoreLaunchAndImpactForHeight">
				<xs:annotation>
					<xs:documentation>
						<![CDATA[Ignore Launch And Impact For Height]]>
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PreserveProportionsDuringWidthScaling">
				<xs:annotation>
					<xs:documentation>
						<![CDATA[Preserve Proportions During Width Scaling
Preserves the initial proportions of the target CActorQuad's launch, center and impact actors when the CActorQuad has been set to respect width scaling, and it has an X scale that is not 1.0.]]>
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RespectWidthScaling">
				<xs:annotation>
					<xs:documentation>
						<![CDATA[Respect Width Scaling
By default, CActorQuad ignores X and Z scaling, so user data can easily change its size with a simple uniform scale.  When this option is set, X scaling affects the width of the target CActorQuad as is common with other actors.]]>
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="EActorRadialDistribution">
		<xs:attribute name="value" type="simple_EActorRadialDistribution"/>
	</xs:complexType>
	<xs:simpleType name="simple_EActorRadialDistribution">
		<xs:restriction base="xs:string">
			<xs:enumeration value="Exponential">
				<xs:annotation>
					<xs:documentation>
						<![CDATA[Exponential
Positions follow an exponential distribution away from the center of the circle.  Exponential distributions often have very high values in the center and very low values at the radius.]]>
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Gaussian">
				<xs:annotation>
					<xs:documentation>
						<![CDATA[Gaussian
Positions follow a Gaussian distribution (i.e. a bell curve) away from the center of the circle.  Gaussian distributions often produce similar results to exponential distributions but with slightly different control parameters.]]>
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Uniform">
				<xs:annotation>
					<xs:documentation>
						<![CDATA[Uniform
Positions are equally distributed across the radius.]]>
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
