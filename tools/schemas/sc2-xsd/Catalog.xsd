	<xs:complexType name="CUpgrade">
		<xs:complexContent>
			<xs:extension base="CBase">
				<xs:choice minOccurs="0" maxOccurs="unbounded">
					<xs:element minOccurs="0" maxOccurs="unbounded" name="Flags">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Flags]]>
							</xs:documentation>
						</xs:annotation>
						<xs:complexType>
							<xs:complexContent>
								<xs:extension base="bool">
									<xs:attribute name="index" type="simple_EUpgradeFlag"/>
