								</xs:extension>
							</xs:complexContent>
						</xs:complexType>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="Select" type="ESoundSelect">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Selection
Order in which the game selects sounds from the soundtrack]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" maxOccurs="1" name="Next" type="CSoundtrackLink">
						<xs:annotation>
							<xs:documentation>
								<![CDATA[Next]]>
							</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:choice>
				<xs:attribute name="Delay" type="simple_CiRange">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Delay
Delay time between songs in the soundtrack]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="Select" type="simple_ESoundSelect">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Selection
Order in which the game selects sounds from the soundtrack]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="Next" type="simple_CSoundtrackLink">
					<xs:annotation>
						<xs:documentation>
							<![CDATA[Next]]>
						</xs:documentation>
					</xs:annotation>
				</xs:attribute>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="CTacCooldown">
