# 发布与分发构建产物（禁止就地编辑）
publish/

# 本地缓存与临时文件
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.DS_Store
Thumbs.db

# 生成的 catalog 索引（可用 tools/build-sc2-catalog-graph.py 重建）
sc2-catalog-graph-out/

# 本地试玩提取日志
bugreport.txt

# 本地备份与临时工作文件（任意层级）
backup/
backups/
temp/
tmp/
**/_backup/
**/_backups/
**/_tmp/
**/_temp/
tmp*/
*.bak
*.tmp
*.orig
.sc2-reference-stage-*/
.sc2-reference-backup-*/

# 本机路径配置（不同机器路径不同，不进版本库）
agent-config.json

# 本机环境变量（任意层级）；可分发的示例与模板保留跟踪
.env
.env.*
!.env.example
!.env.template
!.env.*.example
!.env.*.template

# 本地项目资料、地图工作副本、项目专用工具与历史快照
/projects/

# Workspace reset recovery archive
.workspace-recovery/

# Generated validation reports (any depth) and staged publication/previous versions
reports/
**/.*.stage-*/
**/.*.sc2-previous/
**/.*.sc2-previous.owner.json
**/.*.sc2-retired-*/
**/.*.sc2-publish.lock/
**/.*.sc2-convert.lock/
**/.*.sc2-backup-*

# Shared integration environments, local settings and build metadata
.runtime/
.venv/
*.egg-info/
integrations/**/config.json
integrations/**/profiles/base.patch.yml
integrations/**/state/
integrations/**/.state/
pip-build-env-*/
pip-build-tracker-*/
pip-metadata-*/
pip-ephem-wheel-cache-*/
pip-install-*/
pip-modern-metadata-*/
pip-unpack-*/

# Harness2 local Linux environment, credentials and experiment output
integrations/harness2/.venv-linux/
integrations/harness2/runs/
integrations/harness2/dependencies/*/
